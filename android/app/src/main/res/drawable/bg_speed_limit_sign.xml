<?xml version="1.0" encoding="utf-8"?>
<!-- A road sign of the speed limit: a red ring on white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="oval">
      <solid android:color="@color/dark_red" />
    </shape>
  </item>
  <item android:bottom="3.5dp" android:left="3.5dp" android:right="3.5dp" android:top="3.5dp">
    <shape android:shape="oval">
      <solid android:color="@color/white_primary" />
    </shape>
  </item>
</layer-list>
