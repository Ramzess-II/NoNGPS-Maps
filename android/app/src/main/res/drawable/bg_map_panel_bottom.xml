<?xml version="1.0" encoding="utf-8"?>
<!-- The panel of map buttons docked to an edge of the screen: the edge line is pushed out there. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:left="-2dp" android:right="-2dp" android:bottom="-2dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/map_panel" />
      <stroke
        android:width="1dp"
        android:color="@color/map_panel_edge" />
      <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
    </shape>
  </item>
</layer-list>
