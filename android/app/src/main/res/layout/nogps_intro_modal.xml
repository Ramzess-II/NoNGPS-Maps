<?xml version="1.0" encoding="utf-8"?>
<!-- The modal of the intro of the first start, see nogps.intro.IntroModalFragment. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
  <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_base_plus">
    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/nogps_intro_title"
              android:textAppearance="@style/MwmTextAppearance.Headline"/>
    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/margin_half"
              android:text="@string/nogps_intro_text"
              android:textAppearance="@style/MwmTextAppearance.Body3"/>
    <!-- The shop and the video are secondary: they do not close the modal, the user comes back to it. -->
    <Button android:id="@+id/nogps_intro_buy"
            style="@style/MwmWidget.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_base"
            android:minHeight="@dimen/primary_button_min_height"
            android:text="@string/nogps_box_buy"
            android:textColor="?colorAccent"
            android:textSize="@dimen/text_size_body_3"/>
    <Button android:id="@+id/nogps_intro_video"
            style="@style/MwmWidget.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/primary_button_min_height"
            android:text="@string/nogps_intro_video"
            android:textColor="?colorAccent"
            android:textSize="@dimen/text_size_body_3"/>
    <!-- The only way out of the modal. -->
    <Button android:id="@+id/nogps_intro_understand"
            style="@style/MwmWidget.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_base"
            android:text="@string/nogps_intro_understand"/>
  </LinearLayout>
</ScrollView>
