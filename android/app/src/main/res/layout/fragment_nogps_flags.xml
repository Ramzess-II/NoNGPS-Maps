<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">
  <!-- Scrolls so that the long text doesn't push Send off a small screen. -->
  <ScrollView android:id="@+id/empty"
              android:layout_width="match_parent"
              android:layout_height="0dp"
              android:layout_weight="1"
              android:visibility="gone">
    <TextView style="@style/MwmWidget.TextView.Item"
              android:layout_height="wrap_content"
              android:paddingTop="@dimen/margin_base"
              android:paddingBottom="@dimen/margin_base"
              android:text="@string/nogps_flags_empty"/>
  </ScrollView>

  <ListView android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_nogps_flag"/>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/send"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_base"
    android:enabled="false"
    android:text="@string/nogps_flags_send"/>
</LinearLayout>
