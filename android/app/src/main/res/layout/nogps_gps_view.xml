<?xml version="1.0" encoding="utf-8"?>
<!-- What GPS is worth and why, and its details, see GpsSheetView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
      android:id="@+id/gps_tile"
      android:layout_width="@dimen/map_button_size"
      android:layout_height="@dimen/map_button_size"
      android:background="@drawable/bg_status_button">
      <FrameLayout
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center">
        <ImageView
          android:id="@+id/gps_icon"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no" />
        <ImageView
          android:id="@+id/gps_badge"
          android:layout_width="11dp"
          android:layout_height="11dp"
          android:layout_gravity="top|end"
          android:background="@drawable/bg_source_badge"
          android:importantForAccessibility="no"
          android:padding="1dp"
          android:visibility="gone" />
      </FrameLayout>
    </FrameLayout>
    <TextView
      android:id="@+id/gps_state"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:textSize="17sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/gps_why"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:textColor="?android:textColorSecondary"
    android:textSize="14sp" />

  <LinearLayout
    android:id="@+id/gps_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical" />

  <LinearLayout
    android:id="@+id/gps_satellites"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/nogps_gps_satellites"
      android:textSize="16sp"
      android:textStyle="bold" />
  </LinearLayout>

  <Button
    android:id="@+id/gps_settings"
    style="?borderlessButtonStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/location_settings" />
</merge>
