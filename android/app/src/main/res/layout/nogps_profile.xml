<?xml version="1.0" encoding="utf-8"?>
<!-- The records of every car, see nogps.ProfileFragment: a group for each car is added before the footer. -->
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?cardBackground"
  android:clipToPadding="false"
  android:fillViewport="true">
  <LinearLayout
    android:id="@+id/profile_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_base">
    <TextView
      android:id="@+id/profile_none"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/nogps_sprint_none"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/profile_footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:text="@string/nogps_profile_soon"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
  </LinearLayout>
</ScrollView>
