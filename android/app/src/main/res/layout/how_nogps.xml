<?xml version="1.0" encoding="utf-8"?>
<!-- How NonGPS works, see nogps.HowNoGpsFragment. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?cardBackground"
            android:clipToPadding="false"
            android:fillViewport="true">

  <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_base">

    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/nogps_intro_text"
              android:textAppearance="@style/MwmTextAppearance.Body1"
              android:textColor="?android:textColorPrimary"/>

    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/margin_base_plus"
              android:text="@string/nogps_how_panels"
              android:textAppearance="@style/MwmTextAppearance.Headline"/>

    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/margin_half"
              android:text="@string/nogps_how_bottom"
              android:textAppearance="@style/MwmTextAppearance.Body1"
              android:textColor="?android:textColorPrimary"/>

    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/margin_half"
              android:text="@string/nogps_how_right"
              android:textAppearance="@style/MwmTextAppearance.Body1"
              android:textColor="?android:textColorPrimary"/>

    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/margin_half"
              android:text="@string/nogps_how_left"
              android:textAppearance="@style/MwmTextAppearance.Body1"
              android:textColor="?android:textColorPrimary"/>

    <Button android:id="@+id/nogps_how_intro_again"
            style="@style/MwmWidget.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_base_plus"
            android:text="@string/nogps_how_intro_again"/>

  </LinearLayout>
</ScrollView>
