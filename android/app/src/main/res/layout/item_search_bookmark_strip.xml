<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="@dimen/search_bookmark_strip_item_width"
  android:layout_height="wrap_content"
  android:background="?selectableItemBackground"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:paddingTop="@dimen/margin_half"
  android:paddingBottom="@dimen/margin_half">
  <ImageView
    android:id="@+id/icon"
    android:layout_width="@dimen/track_circle_size"
    android:layout_height="@dimen/track_circle_size"
    android:importantForAccessibility="no"
    tools:background="@color/base_red" />
  <TextView
    android:id="@+id/name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_quarter"
    android:paddingStart="@dimen/margin_quarter"
    android:paddingEnd="@dimen/margin_quarter"
    android:ellipsize="end"
    android:gravity="center_horizontal"
    android:maxLines="1"
    android:textAppearance="@style/MwmTextAppearance.Body4"
    tools:text="Home" />
</LinearLayout>
