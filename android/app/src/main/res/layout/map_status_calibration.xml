<?xml version="1.0" encoding="utf-8"?>
<!-- Flashes at the bottom of the map until the sensor box is calibrated, opens its Calibration page. -->
<TextView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/calibration_status"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:minHeight="36dp"
  android:maxWidth="180dp"
  android:background="@drawable/bg_position_status"
  android:backgroundTint="@color/source_warning"
  android:elevation="2dp"
  android:ellipsize="end"
  android:gravity="center"
  android:maxLines="2"
  android:paddingHorizontal="14dp"
  android:paddingVertical="3dp"
  android:text="@string/nogps_calibration_snackbar"
  android:textColor="@color/white_primary"
  android:textSize="15sp"
  android:textStyle="bold"
  android:visibility="gone" />
