<?xml version="1.0" encoding="utf-8"?>
<!-- GPS | Box: where the position comes from, see SourceSelector. -->
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/source_selector"
  android:layout_width="match_parent"
  android:layout_height="40dp"
  android:background="@drawable/bg_source_selector_track"
  android:padding="2dp">
  <View
    android:id="@+id/source_thumb"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_source_selector_thumb"
    android:elevation="1dp" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="1dp"
    android:orientation="horizontal">
    <LinearLayout
      android:id="@+id/source_gps"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?selectableItemBackgroundBorderless"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:orientation="horizontal">
      <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp">
        <ImageView
          android:id="@+id/source_gps_icon"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no" />
        <ImageView
          android:id="@+id/source_gps_badge"
          android:layout_width="11dp"
          android:layout_height="11dp"
          android:layout_gravity="bottom|end"
          android:background="@drawable/bg_source_badge"
          android:importantForAccessibility="no"
          android:padding="1dp"
          android:visibility="gone" />
      </FrameLayout>
      <TextView
        android:id="@+id/source_gps_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/nogps_status_gps"
        android:textSize="14sp"
        android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/source_box"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?selectableItemBackgroundBorderless"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:orientation="horizontal">
      <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp">
        <ImageView
          android:id="@+id/source_box_icon"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no" />
        <ImageView
          android:id="@+id/source_box_badge"
          android:layout_width="11dp"
          android:layout_height="11dp"
          android:layout_gravity="bottom|end"
          android:background="@drawable/bg_source_badge"
          android:importantForAccessibility="no"
          android:padding="1dp"
          android:visibility="gone" />
      </FrameLayout>
      <TextView
        android:id="@+id/source_box_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/nogps_source_box"
        android:textSize="14sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
