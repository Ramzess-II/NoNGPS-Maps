<?xml version="1.0" encoding="utf-8"?>
<!-- One button for where the position comes from and its accuracy, see StatusBar: it opens the Box sheet. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/status_nav"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:minHeight="@dimen/map_button_size"
  android:background="@drawable/bg_status_button"
  android:clickable="true"
  android:focusable="true"
  android:foreground="?selectableItemBackground"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="14dp"
  android:paddingEnd="10dp">
  <FrameLayout
    android:layout_width="26dp"
    android:layout_height="26dp">
    <ImageView
      android:id="@+id/status_nav_icon"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_gravity="center"
      android:importantForAccessibility="no" />
    <ImageView
      android:id="@+id/status_nav_badge"
      android:layout_width="11dp"
      android:layout_height="11dp"
      android:layout_gravity="top|end"
      android:background="@drawable/bg_source_badge"
      android:importantForAccessibility="no"
      android:padding="1dp"
      android:visibility="gone" />
  </FrameLayout>
  <!-- The word shrinks to fit, but stays readable. The badge sticks out of the icon into the margin. -->
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/status_word"
      android:layout_width="match_parent"
      android:layout_height="20dp"
      android:gravity="center_vertical|start"
      android:importantForAccessibility="no"
      android:maxLines="1"
      android:textColor="?android:textColorPrimary"
      android:textSize="15sp"
      android:textStyle="bold"
      app:autoSizeMaxTextSize="15sp"
      app:autoSizeMinTextSize="11sp"
      app:autoSizeTextType="uniform" />
    <TextView
      android:id="@+id/status_accuracy"
      android:layout_width="match_parent"
      android:layout_height="17dp"
      android:fontFeatureSettings="tnum"
      android:gravity="center_vertical|start"
      android:importantForAccessibility="no"
      android:maxLines="1"
      android:textColor="?android:textColorSecondary"
      android:textSize="13sp"
      app:autoSizeMaxTextSize="13sp"
      app:autoSizeMinTextSize="10sp"
      app:autoSizeTextType="uniform" />
  </LinearLayout>
  <ImageView
    android:layout_width="16dp"
    android:layout_height="16dp"
    android:layout_marginStart="6dp"
    android:importantForAccessibility="no"
    app:srcCompat="@drawable/ic_nogps_chevron_up"
    app:tint="?android:textColorSecondary" />
</LinearLayout>
