<?xml version="1.0" encoding="utf-8"?>
<!-- Zoom and the position, docked to the end edge of the screen. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/right_panel"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_map_panel_end"
  android:elevation="4dp"
  android:orientation="vertical"
  android:paddingTop="4dp"
  android:paddingBottom="4dp">
  <LinearLayout
    android:id="@+id/zoom_buttons_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/nav_zoom_in"
      style="@style/MwmWidget.MapButton.InPanel"
      app:srcCompat="@drawable/ic_plus"
      android:contentDescription="@string/zoom_in" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/nav_zoom_out"
      style="@style/MwmWidget.MapButton.InPanel"
      app:srcCompat="@drawable/ic_minus"
      android:contentDescription="@string/zoom_out" />
    <View style="@style/MwmWidget.MapPanelDivider" />
  </LinearLayout>
  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/my_position"
    style="@style/MwmWidget.MapButton.InPanel"
    android:contentDescription="@string/core_my_position" />
</LinearLayout>
