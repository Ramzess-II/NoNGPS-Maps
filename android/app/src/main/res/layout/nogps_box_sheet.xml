<?xml version="1.0" encoding="utf-8"?>
<!-- The sensor box, or its search when none is set up, see BoxBottomSheet. Scrolls on small screens. -->
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?cardBackground">
<LinearLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="20dp"
  android:paddingTop="16dp"
  android:paddingBottom="24dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
      android:layout_width="@dimen/map_button_size"
      android:layout_height="@dimen/map_button_size"
      android:background="@drawable/bg_status_button">
      <ImageView
        android:id="@+id/box_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_box_title"
        android:textAppearance="?android:textAppearanceLarge"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/box_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_connected"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">
    <TextView
      android:id="@+id/box_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_speed"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_speed_table"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_firmware"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <Button
      android:id="@+id/box_calibrate"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/nogps_sensors_calibrate_box"
      android:textColor="@color/text_primary_disableable" />
    <Button
      android:id="@+id/box_install_firmware"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />
    <Button
      android:id="@+id/box_details"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/nogps_box_details" />
    <Button
      android:id="@+id/box_forget"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/nogps_box_forget"
      android:textColor="@color/base_red" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_search"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/nogps_box_bt_searching">
      <View
        android:id="@+id/box_ring0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_nogps_ring" />
      <View
        android:id="@+id/box_ring1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_nogps_ring" />
      <View
        android:id="@+id/box_ring2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_nogps_ring" />
        <ImageView
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_gravity="center"
          android:background="@drawable/bg_nogps_radar_core"
          android:importantForAccessibility="no"
          android:padding="10dp"
          app:srcCompat="@drawable/ic_nogps_bluetooth"
          app:tint="@android:color/white" />
      </FrameLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step0_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step0"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_bluetooth"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step1_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step1"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_search"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step2_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step2"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_connect"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step3_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step3"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_data"
          android:textSize="15sp" />
      </LinearLayout>
        <Button
          android:id="@+id/box_step_action"
          style="?borderlessButtonStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/nogps_box_power_hint"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_shop"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/nogps_box_buy_text"
      android:textSize="15sp" />
    <Button
      android:id="@+id/box_buy"
      style="@style/MwmWidget.Button.Accent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/nogps_box_buy" />
  </LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
