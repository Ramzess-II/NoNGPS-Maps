<?xml version="1.0" encoding="utf-8"?>
<!-- The sensor box and GPS, or the search of the box when none is set up, and the pages they open, see BoxBottomSheet.
     Scrolls on small screens. All the pages are here, one is shown at a time: hence TooManyViews. -->
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?cardBackground"
  tools:ignore="TooManyViews">
<LinearLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="20dp"
  android:paddingTop="16dp"
  android:paddingBottom="24dp">

  <LinearLayout
    android:id="@+id/box_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <!-- The current car, opens the Cars page. -->
    <LinearLayout
      android:id="@+id/box_title_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:background="?selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:orientation="vertical">
      <TextView
        android:id="@+id/box_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:textAppearanceLarge"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/box_title_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_cars_subtitle"
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp" />
    </LinearLayout>

    <!-- The box and GPS side by side, both open their pages. The states keep their height: the sheet doesn't jump as
         they change, a longer state is cut. -->
    <LinearLayout
      android:id="@+id/box_tiles"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:orientation="horizontal">
      <LinearLayout
        android:id="@+id/box_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_nogps_group"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          android:ellipsize="end"
          android:gravity="center_horizontal"
          android:importantForAccessibility="no"
          android:maxLines="1"
          android:text="@string/nogps_box_title"
          android:textColor="?android:textColorSecondary"
          android:textSize="12sp" />
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <FrameLayout
            android:id="@+id/box_tile"
            android:layout_width="@dimen/map_button_size"
            android:layout_height="@dimen/map_button_size"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_status_button">
            <FrameLayout
              android:layout_width="26dp"
              android:layout_height="26dp"
              android:layout_gravity="center"
              tools:ignore="UselessParent">
              <ImageView
                android:id="@+id/box_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
              <ImageView
                android:id="@+id/box_badge"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_source_badge"
                android:importantForAccessibility="no"
                android:padding="1dp"
                android:visibility="gone" />
            </FrameLayout>
          </FrameLayout>
          <!-- Shown while the tile opens the Box page. -->
          <ImageView
            android:id="@+id/box_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_nogps_chevron" />
        </FrameLayout>
        <TextView
          android:id="@+id/box_state"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:ellipsize="end"
          android:gravity="center_horizontal|top"
          android:lines="3"
          android:textSize="13sp"
          android:textStyle="bold" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/box_gps_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_nogps_group"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          android:ellipsize="end"
          android:gravity="center_horizontal"
          android:importantForAccessibility="no"
          android:maxLines="1"
          android:text="@string/nogps_status_gps"
          android:textColor="?android:textColorSecondary"
          android:textSize="12sp" />
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <FrameLayout
            android:id="@+id/box_gps_tile"
            android:layout_width="@dimen/map_button_size"
            android:layout_height="@dimen/map_button_size"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_status_button">
            <FrameLayout
              android:layout_width="26dp"
              android:layout_height="26dp"
              android:layout_gravity="center"
              tools:ignore="UselessParent">
              <ImageView
                android:id="@+id/box_gps_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
              <ImageView
                android:id="@+id/box_gps_badge"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_source_badge"
                android:importantForAccessibility="no"
                android:padding="1dp"
                android:visibility="gone" />
            </FrameLayout>
          </FrameLayout>
          <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_nogps_chevron" />
        </FrameLayout>
        <TextView
          android:id="@+id/box_gps_state"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:ellipsize="end"
          android:gravity="center_horizontal|top"
          android:lines="3"
          android:textSize="13sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>

    <!-- What the user does for the phone to reach the box set up. -->
    <Button
      android:id="@+id/box_bluetooth"
      style="@style/MwmWidget.Button.Accent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:visibility="gone" />

    <!-- If the car follows GPS. -->
    <androidx.appcompat.widget.SwitchCompat
      android:id="@+id/box_gps_block"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_nogps_group"
      android:minHeight="56dp"
      android:paddingHorizontal="16dp"
      android:text="@string/nogps_gps_block"
      android:textSize="16sp" />
    <!-- Both texts take their place: the sheet doesn't jump as the box comes and goes. -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="4dp"
      android:layout_marginTop="6dp">
      <TextView
        android:id="@+id/box_gps_block_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_gps_block_hint"
        android:textColor="?android:textColorSecondary"
        android:textSize="13sp" />
      <TextView
        android:id="@+id/box_gps_block_needs_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_gps_block_needs_box"
        android:textColor="?android:textColorSecondary"
        android:textSize="13sp" />
    </FrameLayout>
  </LinearLayout>

  <!-- The search of the box of a new car, over the search itself. -->
  <LinearLayout
    android:id="@+id/box_add_car_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_add_car_header"
      layout="@layout/nogps_box_page_header" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/nogps_car_add_text"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_search"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/nogps_box_bt_searching">
        <View
          android:id="@+id/box_ring0"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:alpha="0"
          android:background="@drawable/bg_nogps_ring" />
        <View
          android:id="@+id/box_ring1"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:alpha="0"
          android:background="@drawable/bg_nogps_ring" />
        <View
          android:id="@+id/box_ring2"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:alpha="0"
          android:background="@drawable/bg_nogps_ring" />
        <ImageView
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_gravity="center"
          android:background="@drawable/bg_nogps_radar_core"
          android:importantForAccessibility="no"
          android:padding="10dp"
          app:srcCompat="@drawable/ic_nogps_bluetooth"
          app:tint="@android:color/white" />
      </FrameLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          tools:ignore="UseCompoundDrawables">
          <ImageView
            android:id="@+id/box_step0_dot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />
          <TextView
            android:id="@+id/box_step0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/nogps_box_step_bluetooth"
            android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          tools:ignore="UseCompoundDrawables">
          <ImageView
            android:id="@+id/box_step1_dot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />
          <TextView
            android:id="@+id/box_step1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/nogps_box_step_search"
            android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          tools:ignore="UseCompoundDrawables">
          <ImageView
            android:id="@+id/box_step2_dot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />
          <TextView
            android:id="@+id/box_step2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/nogps_box_step_connect"
            android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          tools:ignore="UseCompoundDrawables">
          <ImageView
            android:id="@+id/box_step3_dot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />
          <TextView
            android:id="@+id/box_step3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/nogps_box_step_data"
            android:textSize="15sp" />
        </LinearLayout>
        <TextView
          android:id="@+id/box_step_hint"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:textSize="14sp"
          android:visibility="gone" />
        <Button
          android:id="@+id/box_step_action"
          style="@style/MwmWidget.Button.Accent"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:paddingHorizontal="@dimen/margin_base"
          android:paddingVertical="10dp"
          android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/nogps_box_power_hint"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
    <!-- On the main page only: the box of a new car is not bought here. -->
    <TextView
      android:id="@+id/box_search_buy_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/nogps_box_buy_text"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
  </LinearLayout>

  <!-- The last rows of the main page. -->
  <LinearLayout
    android:id="@+id/box_shop"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <Button
      android:id="@+id/box_buy"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/nogps_box_buy"
      android:textStyle="bold" />
    <!-- Without a box set up: what the box is for. -->
    <TextView
      android:id="@+id/box_buy_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="4dp"
      android:text="@string/nogps_box_buy_text"
      android:textColor="?android:textColorSecondary"
      android:textSize="13sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_cars_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_cars_header"
      layout="@layout/nogps_box_page_header" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:layout_marginBottom="8dp"
      android:text="@string/nogps_cars_text"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
    <!-- A row for each car, see nogps_car_row. -->
    <LinearLayout
      android:id="@+id/box_cars"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
    <Button
      android:id="@+id/box_add_car"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="start|center_vertical"
      android:text="@string/nogps_car_add" />
  </LinearLayout>

  <!-- A car of the user: its name, what the user does with it and the phones of its box. -->
  <LinearLayout
    android:id="@+id/box_car_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_car_header"
      layout="@layout/nogps_box_page_header" />
    <!-- A tap renames the car. -->
    <LinearLayout
      android:id="@+id/box_car_page_name_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/box_car_page_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="@string/nogps_car_name"
        android:textSize="16sp" />
      <TextView
        android:id="@+id/box_car_page_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:textColor="?android:textColorSecondary"
        android:textSize="16sp" />
    </LinearLayout>
    <!-- Not for the car driven now. -->
    <TextView
      android:id="@+id/box_car_drive"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:text="@string/nogps_car_drive"
      android:textColor="?colorAccent"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_car_forget"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:text="@string/nogps_car_forget"
      android:textColor="@color/base_red"
      android:textSize="16sp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/nogps_car_phones"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp"
      android:textStyle="bold" />
    <!-- While the box of the car is connected: a row for each of its phones, see nogps_car_row, a tap removes it. -->
    <LinearLayout
      android:id="@+id/box_phones"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <LinearLayout
        android:id="@+id/box_phones_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
      <Button
        android:id="@+id/box_add_phone"
        style="?borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/nogps_phone_add" />
      <TextView
        android:id="@+id/box_phones_read_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/nogps_box_read_only"
        android:textColor="?android:textColorSecondary"
        android:textSize="14sp" />
    </LinearLayout>
    <TextView
      android:id="@+id/box_phones_unknown"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/nogps_car_phones_unknown"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
  </LinearLayout>

  <!-- The box, the car and what is learned about them, by sections that fold. -->
  <LinearLayout
    android:id="@+id/box_box_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_box_header"
      layout="@layout/nogps_box_page_header" />
    <TextView
      android:id="@+id/box_readiness"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textSize="17sp"
      android:textStyle="bold" />

    <!-- One group: each item opens its page. -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_nogps_group"
      android:orientation="vertical">
      <include
        android:id="@+id/box_item_box"
        layout="@layout/nogps_box_section" />
      <include
        android:id="@+id/box_item_obd"
        layout="@layout/nogps_box_section" />
      <include
        android:id="@+id/box_item_car"
        layout="@layout/nogps_box_section" />
      <include
        android:id="@+id/box_item_speed"
        layout="@layout/nogps_box_section" />
      <include
        android:id="@+id/box_item_imu"
        layout="@layout/nogps_box_section" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_box_item_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_box_item_header"
      layout="@layout/nogps_box_page_header" />
    <LinearLayout
      android:id="@+id/box_section_box_content"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <!-- Another phone has connected to the box first: it calibrates and updates the box. -->
      <TextView
        android:id="@+id/box_read_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/nogps_box_read_only"
        android:textColor="?android:textColorSecondary"
        android:textSize="14sp" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_sensors_hint_box"
        android:textColor="?android:textColorSecondary"
        android:textSize="14sp" />
      <!-- As the box values under it: the version, or how the update goes. -->
      <include
        android:id="@+id/box_firmware_row"
        layout="@layout/nogps_sheet_row" />
      <!-- Install, or Cancel while it is sent. -->
      <TextView
        android:id="@+id/box_firmware_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:textColor="?colorAccent"
        android:textSize="16sp" />
      <LinearLayout
        android:id="@+id/box_values_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_obd_item_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_obd_item_header"
      layout="@layout/nogps_box_page_header" />
    <LinearLayout
      android:id="@+id/box_values_obd"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_car_item_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_car_item_header"
      layout="@layout/nogps_box_page_header" />
    <LinearLayout
      android:id="@+id/box_section_car_content"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <TextView
        android:id="@+id/box_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:textSize="16sp" />
      <!-- The car current now: opens its page. -->
      <LinearLayout
        android:id="@+id/box_car_name_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="12dp"
          android:text="@string/nogps_car_name"
          android:textSize="16sp" />
        <TextView
          android:id="@+id/box_car_name"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="end|center_vertical"
          android:textColor="?android:textColorSecondary"
          android:textSize="16sp"
          app:drawableEndCompat="@drawable/ic_nogps_chevron" />
      </LinearLayout>
      <!-- Its best time, a tap opens the results. -->
      <LinearLayout
        android:id="@+id/box_sprint_to100_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="12dp"
          android:text="@string/nogps_sprint_to100"
          android:textSize="16sp" />
        <TextView
          android:id="@+id/box_sprint_to100_best"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFeatureSettings="tnum"
          android:gravity="end|center_vertical"
          android:textColor="?android:textColorSecondary"
          android:textSize="16sp"
          app:drawableEndCompat="@drawable/ic_nogps_chevron" />
      </LinearLayout>
      <!-- Its best time, a tap opens the results. -->
      <LinearLayout
        android:id="@+id/box_sprint_quarter_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="12dp"
          android:text="@string/nogps_sprint_quarter_mile"
          android:textSize="16sp" />
        <TextView
          android:id="@+id/box_sprint_quarter_best"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFeatureSettings="tnum"
          android:gravity="end|center_vertical"
          android:textColor="?android:textColorSecondary"
          android:textSize="16sp"
          app:drawableEndCompat="@drawable/ic_nogps_chevron" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/box_values_car"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
      <TextView
        android:id="@+id/box_voltage_mismatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_voltage_mismatch"
        android:textColor="@color/base_red"
        android:textSize="14sp"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>

  <!-- The results of one kind of the timed runs of the car, newest first. -->
  <LinearLayout
    android:id="@+id/box_sprint_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_sprint_header"
      layout="@layout/nogps_box_page_header" />
    <LinearLayout
      android:id="@+id/box_sprint_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
    <TextView
      android:id="@+id/box_sprint_none"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/nogps_sprint_none"
      android:textColor="?android:textColorSecondary"
      android:textSize="15sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_speed_item_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_speed_item_header"
      layout="@layout/nogps_box_page_header" />
    <LinearLayout
      android:id="@+id/box_section_speed_content"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_speed_table_hint"
        android:textColor="?android:textColorSecondary"
        android:textSize="15sp" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/nogps_speed_table_action"
        android:textSize="15sp"
        android:textStyle="bold" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nogps_speed_lag"
            android:textSize="16sp" />
          <TextView
            android:id="@+id/box_speed_lag_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:textColorSecondary"
            android:textSize="14sp" />
        </LinearLayout>
        <TextView
          android:id="@+id/box_speed_lag_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:fontFeatureSettings="tnum"
          android:textColor="?android:textColorSecondary"
          android:textSize="16sp" />
      </LinearLayout>
      <Button
        android:id="@+id/box_clear_speed"
        style="?borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_box_clear_speed"
        android:textColor="@color/source_warning" />
      <LinearLayout
        android:id="@+id/box_speed_table_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_imu_item_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_imu_item_header"
      layout="@layout/nogps_box_page_header" />
    <LinearLayout
      android:id="@+id/box_section_imu_content"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <!-- Opens the Calibration page. -->
      <LinearLayout
        android:id="@+id/box_calibration_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="12dp"
          android:text="@string/nogps_box_calibration"
          android:textSize="16sp" />
        <TextView
          android:id="@+id/box_calibration_value"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="end|center_vertical"
          android:textColor="?android:textColorSecondary"
          android:textSize="16sp"
          app:drawableEndCompat="@drawable/ic_nogps_chevron" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/box_values_imu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_calibration_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_calibration_header"
      layout="@layout/nogps_box_page_header" />
    <!-- When and how. -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/nogps_box_calibration_hint"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/nogps_calibration_steps"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/box_calibration_state"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textSize="17sp"
      android:textStyle="bold" />
    <ProgressBar
      android:id="@+id/box_calibration_progress"
      style="?android:progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:max="100" />
    <!-- What went wrong and what the user does next. -->
    <TextView
      android:id="@+id/box_calibration_result"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
    <Button
      android:id="@+id/box_calibrate"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:textStyle="bold" />
    <!-- Why the box can't be calibrated now. -->
    <TextView
      android:id="@+id/box_calibrate_reason"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_gps_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <include
      android:id="@+id/box_gps_header"
      layout="@layout/nogps_box_page_header" />
    <app.organicmaps.nogps.GpsSheetView
      android:id="@+id/box_gps_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp" />
  </LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
