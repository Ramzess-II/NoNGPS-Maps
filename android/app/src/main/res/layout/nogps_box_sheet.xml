<?xml version="1.0" encoding="utf-8"?>
<!-- The sensor box, its GPS row and page, its speed table, or its search when none is set up, see BoxBottomSheet. Scrolls on small
     screens. -->
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?cardBackground">
<LinearLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="20dp"
  android:paddingTop="16dp"
  android:paddingBottom="24dp">

  <!-- The box and GPS side by side, GPS opens its page. The states keep their height: the sheet doesn't jump as they
       change, a longer state is cut. -->
  <LinearLayout
    android:id="@+id/box_tiles"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <LinearLayout
      android:id="@+id/box_box"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:background="@drawable/bg_nogps_group"
      android:focusable="true"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:padding="12dp">
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/nogps_box_title"
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp" />
      <FrameLayout
        android:id="@+id/box_tile"
        android:layout_width="@dimen/map_button_size"
        android:layout_height="@dimen/map_button_size"
        android:background="@drawable/bg_status_button">
        <FrameLayout
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:layout_gravity="center">
          <ImageView
            android:id="@+id/box_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
          <ImageView
            android:id="@+id/box_badge"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_source_badge"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:visibility="gone" />
        </FrameLayout>
      </FrameLayout>
      <TextView
        android:id="@+id/box_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:lines="3"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout
      android:id="@+id/box_gps_row"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:background="@drawable/bg_nogps_group"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?selectableItemBackground">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          android:ellipsize="end"
          android:gravity="center_horizontal"
          android:importantForAccessibility="no"
          android:maxLines="1"
          android:text="@string/nogps_status_gps"
          android:textColor="?android:textColorSecondary"
          android:textSize="12sp" />
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <FrameLayout
            android:id="@+id/box_gps_tile"
            android:layout_width="@dimen/map_button_size"
            android:layout_height="@dimen/map_button_size"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_status_button">
            <FrameLayout
              android:layout_width="26dp"
              android:layout_height="26dp"
              android:layout_gravity="center">
              <ImageView
                android:id="@+id/box_gps_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
              <ImageView
                android:id="@+id/box_gps_badge"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_source_badge"
                android:importantForAccessibility="no"
                android:padding="1dp"
                android:visibility="gone" />
            </FrameLayout>
          </FrameLayout>
          <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_nogps_chevron" />
        </FrameLayout>
        <TextView
          android:id="@+id/box_gps_state"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:ellipsize="end"
          android:gravity="center_horizontal|top"
          android:lines="3"
          android:textSize="13sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>

  <!-- If the car follows GPS. -->
  <LinearLayout
    android:id="@+id/box_gps_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">
    <androidx.appcompat.widget.SwitchCompat
      android:id="@+id/box_gps_use"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_nogps_group"
      android:minHeight="56dp"
      android:paddingHorizontal="16dp"
      android:text="@string/nogps_gps_use"
      android:textSize="16sp" />
    <!-- Both texts take their place: the sheet doesn't jump as the box comes and goes. -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="4dp"
      android:layout_marginTop="6dp">
      <TextView
        android:id="@+id/box_gps_use_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_gps_use_hint"
        android:textColor="?android:textColorSecondary"
        android:textSize="13sp" />
      <TextView
        android:id="@+id/box_gps_use_needs_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_gps_use_needs_box"
        android:textColor="?android:textColorSecondary"
        android:textSize="13sp" />
    </FrameLayout>
    <!-- Other apps take the position of the car while GPS isn't used. -->
    <androidx.appcompat.widget.SwitchCompat
      android:id="@+id/box_share_position"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_nogps_group"
      android:minHeight="56dp"
      android:paddingHorizontal="16dp"
      android:text="@string/nogps_share_position"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_share_position_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="4dp"
      android:layout_marginTop="6dp"
      android:text="@string/nogps_share_position_hint"
      android:textColor="?android:textColorSecondary"
      android:textSize="13sp" />
    <!-- Tapped, opens Developer options. -->
    <TextView
      android:id="@+id/box_share_position_needs_mock"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:background="?selectableItemBackground"
      android:paddingHorizontal="4dp"
      android:paddingVertical="4dp"
      android:text="@string/nogps_share_position_needs_mock"
      android:textColor="?colorAccent"
      android:textSize="13sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_connected"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">
    <Button
      android:id="@+id/box_bluetooth"
      style="@style/MwmWidget.Button.Accent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginVertical="8dp"
      android:visibility="gone" />
    <TextView
      android:id="@+id/box_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_speed"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_rpm"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/box_firmware"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:textSize="16sp" />
    <Button
      android:id="@+id/box_install_firmware"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />
    <LinearLayout
      android:id="@+id/box_calibrate"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:background="?selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="48dp"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/box_calibration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp" />
      <TextView
        android:id="@+id/box_calibrate_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:textColor="?colorAccent"
        android:textSize="16sp"
        app:drawableEndCompat="@drawable/ic_nogps_chevron" />
    </LinearLayout>
    <!-- What the app has learned about the car speed. -->
    <LinearLayout
      android:id="@+id/box_speed_group"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="?android:listDivider" />
      <LinearLayout
        android:id="@+id/box_speed_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="12dp"
          android:text="@string/nogps_speed_table_title"
          android:textSize="16sp" />
        <TextView
          android:id="@+id/box_speed_table_state"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="end|center_vertical"
          android:textColor="?android:textColorSecondary"
          android:textSize="16sp"
          app:drawableEndCompat="@drawable/ic_nogps_chevron" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/box_speed_lag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nogps_speed_lag"
            android:textSize="16sp" />
          <TextView
            android:id="@+id/box_speed_lag_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:textColorSecondary"
            android:textSize="14sp" />
        </LinearLayout>
        <TextView
          android:id="@+id/box_speed_lag_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:fontFeatureSettings="tnum"
          android:textColor="?android:textColorSecondary"
          android:textSize="16sp" />
      </LinearLayout>
      <Button
        android:id="@+id/box_clear_speed"
        style="?borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nogps_box_clear_speed"
        android:textColor="@color/source_warning" />
    </LinearLayout>
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="8dp"
      android:background="?android:listDivider" />
    <Button
      android:id="@+id/box_buy_another"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/nogps_box_buy" />
    <Button
      android:id="@+id/box_forget"
      style="?borderlessButtonStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/nogps_box_forget"
      android:textColor="@color/base_red" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_speed_table_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/box_speed_table_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:scaleType="center"
        app:srcCompat="?homeAsUpIndicator" />
      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/nogps_speed_table_title"
        android:textAppearance="?android:textAppearanceLarge"
        android:textStyle="bold" />
    </LinearLayout>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/nogps_speed_table_hint"
      android:textColor="?android:textColorSecondary"
      android:textSize="15sp" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="@string/nogps_speed_table_action"
      android:textSize="15sp"
      android:textStyle="bold" />
    <LinearLayout
      android:id="@+id/box_speed_table_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="vertical" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_values_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/box_values_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:scaleType="center"
        app:srcCompat="?homeAsUpIndicator" />
      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/nogps_box_value_title"
        android:textAppearance="?android:textAppearanceLarge"
        android:textStyle="bold" />
    </LinearLayout>
    <!-- Filled by the code: a header for each group and its rows. -->
    <LinearLayout
      android:id="@+id/box_values_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_gps_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/box_gps_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:scaleType="center"
        app:srcCompat="?homeAsUpIndicator" />
      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/nogps_status_gps"
        android:textAppearance="?android:textAppearanceLarge"
        android:textStyle="bold" />
    </LinearLayout>
    <app.organicmaps.nogps.GpsSheetView
      android:id="@+id/box_gps_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_search"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/nogps_box_bt_searching">
      <View
        android:id="@+id/box_ring0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_nogps_ring" />
      <View
        android:id="@+id/box_ring1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_nogps_ring" />
      <View
        android:id="@+id/box_ring2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_nogps_ring" />
        <ImageView
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_gravity="center"
          android:background="@drawable/bg_nogps_radar_core"
          android:importantForAccessibility="no"
          android:padding="10dp"
          app:srcCompat="@drawable/ic_nogps_bluetooth"
          app:tint="@android:color/white" />
      </FrameLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step0_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step0"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_bluetooth"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step1_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step1"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_search"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step2_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step2"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_connect"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
          android:id="@+id/box_step3_dot"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:importantForAccessibility="no" />
        <TextView
          android:id="@+id/box_step3"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:text="@string/nogps_box_step_data"
          android:textSize="15sp" />
      </LinearLayout>
        <Button
          android:id="@+id/box_step_action"
          style="@style/MwmWidget.Button.Accent"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:paddingHorizontal="@dimen/margin_base"
          android:paddingVertical="10dp"
          android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/nogps_box_power_hint"
      android:textColor="?android:textColorSecondary"
      android:textSize="14sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/box_shop"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/nogps_box_buy_text"
      android:textSize="15sp" />
    <Button
      android:id="@+id/box_buy"
      style="@style/MwmWidget.Button.Accent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/nogps_box_buy" />
  </LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
